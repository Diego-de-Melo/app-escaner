{
  "expo": {
    "name": "SmartScannerEstoque",
    "slug": "SmartScannerEstoque",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.smartscannerestoque",
      "infoPlist": {
        "NSCameraUsageDescription": "Este aplicativo precisa de acesso à sua câmera para escanear etiquetas de produtos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.smartscannerestoque",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-vision-camera",
      "@react-native-firebase/app",
      "@react-native-firebase/ml-vision"
    ]
  }
}
